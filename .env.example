# Copy to your Embarko environment / secrets. Never commit real values.

# Web
PORT=3000
# Writable, persistent directory for the SQLite file (demo storage only)
DATA_DIR=./data
# Public base URL of the deployed app (used for viaSocket callback URLs)
PUBLIC_URL=
# How long one approval stays valid before execution (ms)
APPROVAL_TTL_MS=120000
# Simulated destination latency (ms) so the "Retrying" state is visible
SIM_DELAY_MS=1500

# viaSocket — leave VIASOCKET_MODE=simulated until credentials exist
VIASOCKET_MODE=simulated
# From viaSocket → Embed → Settings
VIASOCKET_ORG_ID=
VIASOCKET_PROJECT_ID=
VIASOCKET_ACCESS_KEY=
# Override only if viaSocket documents a different script URL
VIASOCKET_EMBED_SCRIPT_URL=https://embed.viasocket.com/prod-embedcomponent.js
# Shared secret used by viaSocket flows to sign reports to /api/webhooks/viasocket
VIASOCKET_WEBHOOK_SECRET=
# Webhook-trigger URLs of the single-operation retry flows
VIASOCKET_RETRY_AIRTABLE_URL=
VIASOCKET_RETRY_SLACK_URL=
